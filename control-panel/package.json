{
  "name": "cliproxy-control-panel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "format": "prettier --write .",
    "predev": "node scripts/build-database.mjs",
    "db:build": "node scripts/build-database.mjs",
    "dev": "node --env-file=../.local-panel/.env scripts/dev.mjs",
    "proxy:start": "node scripts/proxy-local.mjs",
    "build": "tsc -b && vite build",
    "start": "node scripts/start.mjs",
    "test": "node --test server.test.mjs affinity.test.mjs quota-observations.test.mjs quota-admission.test.mjs database.test.mjs database-transfer.test.mjs integrations.test.mjs client-enrollment.test.mjs import-handoff.test.mjs",
    "db:restore": "node scripts/restore-database.mjs",
    "tailscale:build": "node scripts/build-tailscale.mjs",
    "test:ui": "vitest run",
    "test:oauth": "node --test oauth.integration.test.mjs",
    "test:integration": "node --test integration.test.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vitest": "^4.1.11"
  }
}
